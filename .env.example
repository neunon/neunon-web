# サイトの公開URL（末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=https://neun-on.com

# CMS OAuth Worker origin only (public URL, never a secret). Leave blank until deployed.
CMS_AUTH_BASE_URL=

# ------------------------------------------------------------
# フォーム送信先（Cloudflare Worker）
# ------------------------------------------------------------
# 静的サイトから専用Workerの2パスへ送信する。
# 値は https://neunon-form-api.keisakamoto.workers.dev/contact と /entry。
# 未設定の間は送信ボタンが押せない状態になり、画面に案内が出る。
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_ENTRY_FORM_ENDPOINT=

# ------------------------------------------------------------
# スパム対策
# ------------------------------------------------------------
# 現在はTurnstile、honeypot、入力時間のチェックで対応。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------
# アクセス解析
# ------------------------------------------------------------
GA_MEASUREMENT_ID=
