# サイトの公開URL（末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=https://neun-on.com

# ------------------------------------------------------------
# フォーム送信先（Formspree）
# ------------------------------------------------------------
# 本サイトは output: 'export' の静的書き出しのため、サーバー側で
# メールを送る API Route を持てない。ブラウザから Formspree の
# エンドポイントを直接叩くので、NEXT_PUBLIC_ 接頭辞が必要。
# 値は https://formspree.io/f/xxxxxxxx の形式。
# 企業用と学生用でフォームを分けるため、エンドポイントも2つ用意する
# （要件定義書 6.8「企業用と学生用でフォームを分けること」）。
# 未設定の間は送信ボタンが押せない状態になり、画面に案内が出る。
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_ENTRY_FORM_ENDPOINT=

# 通知先メールアドレス
# Formspree 側のフォーム設定で指定する。アプリからは参照しないが、
# 運用担当が把握できるようここにも控えておく。
# 【要確認】代表アドレスの新設と合わせて決定する（要件定義書 14.）
CONTACT_NOTIFY_EMAIL=
ENTRY_NOTIFY_EMAIL=

# ------------------------------------------------------------
# スパム対策
# ------------------------------------------------------------
# 現在は honeypot（Formspree の _gotcha）と入力時間のチェックで対応している
# （要件定義書 6.8 は「reCAPTCHA v3 もしくは honeypot」を許容）。
# reCAPTCHA を使う場合は Formspree 側の設定で有効化する。
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ------------------------------------------------------------
# アクセス解析
# ------------------------------------------------------------
GA_MEASUREMENT_ID=

# ------------------------------------------------------------
# 表示オプション
# ------------------------------------------------------------
# off にするとスクロール時のフェードイン演出を無効化する
# （要件定義書 9.2 とデザイン案 v2 の食い違いへの逃げ道）
NEXT_PUBLIC_SCROLL_REVEAL=
