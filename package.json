{
  "name": "neunon-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-cms.mjs && next dev",
    "build": "node scripts/audit-content.mjs && node scripts/prepare-cms.mjs && next build",
    "build:deploy": "npm run build && node scripts/audit.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:worker": "node --test worker/test/*.test.mjs",
    "images": "node scripts/generate-images.mjs",
    "audit:html": "node scripts/audit.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "test:cms": "node --test scripts/test/*.test.mjs cms-auth-worker/test/*.test.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "decap-cms": "3.16.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
